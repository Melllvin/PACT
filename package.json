{
  "name": "pact",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run coverage",
    "test:e2e": "npm run build && playwright test",
    "dist": "electron-builder",
    "postinstall": "electron-rebuild -f -w node-pty"
  },
  "dependencies": {
    "@xterm/addon-fit": "latest",
    "@xterm/addon-serialize": "latest",
    "@xterm/addon-unicode11": "latest",
    "@xterm/addon-web-links": "latest",
    "@xterm/addon-webgl": "latest",
    "@xterm/xterm": "6.0.0",
    "electron": "44.0.0",
    "node-pty": "1.1.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "4.1.11",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@electron/rebuild": "latest",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/react": "latest",
    "@testing-library/user-event": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "5.0.4",
    "@vitest/coverage-v8": "5.0.0",
    "electron-builder": "26.0.12",
    "electron-vite": "5.0.0",
    "eslint": "10.0.0",
    "eslint-plugin-react-hooks": "latest",
    "jsdom": "latest",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "typescript-eslint": "latest",
    "vite": "7.1.7",
    "vitest": "5.0.0"
  }
}
