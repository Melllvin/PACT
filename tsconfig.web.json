{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "outDir": ".tsbuild/web",
    "paths": { "@shared/*": ["./src/shared/*"], "@/*": ["./src/renderer/*"] }
  },
  "include": [
    "src/renderer/**/*.ts",
    "src/renderer/**/*.tsx",
    "src/shared/**/*.ts",
    "tests/unit/renderer/**/*.ts",
    "tests/unit/renderer/**/*.tsx",
    "tests/setup/renderer.ts"
  ]
}
