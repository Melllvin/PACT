{
  "echo": true,
  "permission": "rm fichier.txt",
  "permissionOn": "SUPPRIME",
  "mcp": [
    {
      "tool": "send_message",
      "arguments": {
        "to": "{{prompt.0}}",
        "text": "{{prompt.1}}"
      }
    }
